# Variáveis de ambiente (no Railway: aba Variables do serviço)
DATABASE_URL=postgresql://...        # no Railway: ${{Postgres.DATABASE_URL}}. Sem ela, usa um arquivo SQLite local.
SECRET_KEY=gere-com-python--c-"import secrets; print(secrets.token_hex(32))"
ADMIN_USER=admin
ADMIN_PASSWORD=uma-senha-forte       # lida só na primeira subida, para criar o administrador
HTTPS_ONLY=1                         # em produção (cookies só por HTTPS)
CLINIC_NAME=Clínica Exemplo
# BASE_URL=https://avaliacao.seudominio.com.br   # opcional: fixa o endereço usado nos links
# DEMO=1                             # carrega dados fictícios para demonstração (nunca use em produção)
